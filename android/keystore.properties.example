# Release signing credentials for the Android app.
#
# Copy this file to `android/keystore.properties` (gitignored) and fill in the
# real values. Without it, `assembleRelease` falls back to debug signing so
# local builds still work, but the artifact is NOT release-signed.
#
# RELEASE_STORE_FILE is resolved relative to android/app/.

RELEASE_STORE_FILE=scrolltax-release.keystore
RELEASE_STORE_PASSWORD=changeme
RELEASE_KEY_ALIAS=scrolltax
RELEASE_KEY_PASSWORD=changeme
