SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Public Strava OAuth client id (used to build the authorize URL on-device).
# The matching STRAVA_CLIENT_SECRET is set as a Supabase function secret, not here.
STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID
# XRPL network: 'testnet' (default, free test XRP) or 'mainnet' (real funds).
# Leave as testnet until the mainnet readiness gates (custody, audit, legal) pass.
XRPL_NETWORK=testnet
# Collection ("house") wallet for penalties with no group mates and forfeited
# stakes. Set the same value as the HOUSE_WALLET Supabase function secret.
HOUSE_WALLET=rHb9CJAWyB4rj91VRWn96DkukG4bwdtyTh
# Public address of the custodial treasury that group stakes are deposited into.
TREASURY_ADDRESS=

# ── Server-only secrets (set via `supabase secrets set`, NOT in the app bundle) ──
# TREASURY_SEED          seed for the treasury account — single-signs payouts
# TREASURY_SIGNER_SEEDS  comma-separated signer seeds for MULTISIGN payouts (>= quorum).
#                        When set, payouts are multisigned and TREASURY_SEED is unused.
#                        In production these live in separate KMS/HSM stores, not all here.
# TREASURY_ADMIN_SECRET  shared secret gating the treasury `payout` action
# XRPL_RPC_URL           XRPL JSON-RPC HTTP endpoint (testnet default in code)
# HOUSE_WALLET           same value as above, for the self-bet forfeit destination
